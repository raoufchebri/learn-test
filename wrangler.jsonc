{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "replit-learn",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-07",
  "preview_urls": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AUTH_SESSIONS",
        "class_name": "AuthSessionStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AuthSessionStore"]
    }
  ],
  "vectorize": [
    {
      "binding": "LEARN_VECTORIZE",
      "index_name": "replit-learn-openai"
    }
  ],
  "vars": {
    "REPLIT_OIDC_ISSUER": "https://replit.com/oidc",
    "REPLIT_MCP_URL": "https://replit-mcp.com/server/mcp"
  }
}
