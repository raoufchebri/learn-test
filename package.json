{
  "name": "replit-learn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/generate-learn-index.mjs && vite",
    "dev:auth": "pnpm build && wrangler dev --ip 0.0.0.0 --port 4173",
    "build": "node scripts/generate-learn-index.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "generate:learn-index": "node scripts/generate-learn-index.mjs",
    "upsert:learn-index": "node scripts/upsert-rag-manifest.mjs public/retrieval/replit-learn-index.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fumadocs-core": "16.14.1",
    "fumadocs-mdx": "15.2.2",
    "fumadocs-ui": "16.14.0",
    "jose": "6.1.0",
    "lucide-react": "1.28.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "vite": "8.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/mdx": "2.0.14",
    "@types/node": "22.15.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "wrangler": "4.120.0"
  }
}
